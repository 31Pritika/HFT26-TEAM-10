{
  "manifest_version": 3,
  "name": "ShadowScope Shadow Sensor",
  "version": "0.2.0",
  "description": "Catches secrets and personal data before they are pasted into AI chat tools. Scans locally, reports only to localhost.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://huggingface.co/chat*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "ShadowScope Shadow Sensor",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/chat*"
      ],
      "js": ["src/scanner.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
